{"ast":null,"code":"import{useState,useCallback}from'react';export const useToast=()=>{const[toasts,setToasts]=useState([]);const showToast=useCallback((message,type='info')=>{const id=Date.now();setToasts(prev=>[...prev,{id,message,type}]);},[]);const dismissToast=useCallback(id=>{setToasts(prev=>prev.filter(t=>t.id!==id));},[]);return{toasts,showToast,dismissToast};};","map":{"version":3,"names":["useState","useCallback","useToast","toasts","setToasts","showToast","message","type","id","Date","now","prev","dismissToast","filter","t"],"sources":["C:/Users/Luis/Documents/proyectos/SaaS-O-Matic/frontend/src/hooks/useToast.ts"],"sourcesContent":["import { useState, useCallback } from 'react';\r\n\r\nexport const useToast = () => {\r\n  const [toasts, setToasts] = useState<Array<{ id: number; message: string; type: 'success' | 'error' | 'info' }>>([]);\r\n\r\n  const showToast = useCallback((message: string, type: 'success' | 'error' | 'info' = 'info') => {\r\n    const id = Date.now();\r\n    setToasts(prev => [...prev, { id, message, type }]);\r\n  }, []);\r\n\r\n  const dismissToast = useCallback((id: number) => {\r\n    setToasts(prev => prev.filter(t => t.id !== id));\r\n  }, []);\r\n\r\n  return { toasts, showToast, dismissToast };\r\n};"],"mappings":"AAAA,OAASA,QAAQ,CAAEC,WAAW,KAAQ,OAAO,CAE7C,MAAO,MAAM,CAAAC,QAAQ,CAAGA,CAAA,GAAM,CAC5B,KAAM,CAACC,MAAM,CAAEC,SAAS,CAAC,CAAGJ,QAAQ,CAA6E,EAAE,CAAC,CAEpH,KAAM,CAAAK,SAAS,CAAGJ,WAAW,CAAC,CAACK,OAAe,CAAEC,IAAkC,CAAG,MAAM,GAAK,CAC9F,KAAM,CAAAC,EAAE,CAAGC,IAAI,CAACC,GAAG,CAAC,CAAC,CACrBN,SAAS,CAACO,IAAI,EAAI,CAAC,GAAGA,IAAI,CAAE,CAAEH,EAAE,CAAEF,OAAO,CAAEC,IAAK,CAAC,CAAC,CAAC,CACrD,CAAC,CAAE,EAAE,CAAC,CAEN,KAAM,CAAAK,YAAY,CAAGX,WAAW,CAAEO,EAAU,EAAK,CAC/CJ,SAAS,CAACO,IAAI,EAAIA,IAAI,CAACE,MAAM,CAACC,CAAC,EAAIA,CAAC,CAACN,EAAE,GAAKA,EAAE,CAAC,CAAC,CAClD,CAAC,CAAE,EAAE,CAAC,CAEN,MAAO,CAAEL,MAAM,CAAEE,SAAS,CAAEO,YAAa,CAAC,CAC5C,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}